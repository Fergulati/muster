{
  "about": "Recording a voice note from the message row (docs/design/voice-notes.md §8): the module's recording shows as a banner whoever started it, with the time, the level and Stop; Stop makes a draft whose surface shows Play, Send, Discard and who will see what before anything is sent; the module's refusal and its note show as it says them. voiceJson and voiceResultJson are copied from the shapes voice_status and the voice methods pin (no runner records one until S9).",
  "snapshot": "data/statement-proposed.json",
  "sizes": [
    "1440x900"
  ],
  "props": {
    "voiceJson": {
      "ready": {
        "capture": "ok",
        "playback": "unknown",
        "codec": "libopus 1.5.2",
        "note": ""
      },
      "recording": {
        "state": "recording",
        "elapsedMs": 1200,
        "capMs": 60000,
        "peak": 9000,
        "capped": false,
        "silent": false,
        "error": ""
      },
      "playing": null
    },
    "voiceResultJson": ""
  },
  "steps": [
    {
      "view": "room"
    },
    {
      "expectProp": [
        "voiceRecording",
        "visible",
        true
      ]
    },
    {
      "expectProp": [
        "voiceRecordingTime",
        "text",
        "~0:01"
      ]
    },
    {
      "expectProp": [
        "voiceRecordButton",
        "visible",
        false
      ]
    },
    {
      "wait": 700
    },
    {
      "expect": {
        "slot": "loadVoice"
      }
    },
    {
      "shot": "recording"
    },
    {
      "click": "voiceStopButton"
    },
    {
      "expect": {
        "slot": "stopVoiceRecording"
      }
    },
    {
      "props": {
        "voiceJson": {
          "ready": {
            "capture": "ok",
            "playback": "unknown",
            "codec": "libopus 1.5.2",
            "note": ""
          },
          "recording": {
            "state": "draft",
            "elapsedMs": 4200,
            "capMs": 60000,
            "peak": 12000,
            "capped": false,
            "silent": false,
            "error": ""
          },
          "playing": null
        },
        "voiceResultJson": {
          "draft": {
            "durationMs": 4200,
            "silent": false,
            "peak": 12000
          }
        }
      }
    },
    {
      "expectProp": [
        "voiceRecording",
        "visible",
        false
      ]
    },
    {
      "expectProp": [
        "voiceDraft",
        "visible",
        true
      ]
    },
    {
      "expectProp": [
        "voiceDraftTime",
        "text",
        "~0:04"
      ]
    },
    {
      "expectProp": [
        "voiceDisclosure",
        "text",
        "Everyone in this room can play it. Your voice can identify you, here and outside this room. The store node sees two sealed frames of one fixed size, and when."
      ]
    },
    {
      "expectProp": [
        "voiceDisclosure",
        "visible",
        true
      ]
    },
    {
      "shot": "draft"
    },
    {
      "click": "voiceDraftPlay"
    },
    {
      "expect": {
        "slot": "playVoiceNote",
        "args": [
          "draft"
        ]
      }
    },
    {
      "click": "voiceSendButton"
    },
    {
      "expect": {
        "slot": "sendVoiceDraft"
      }
    },
    {
      "props": {
        "voiceJson": {
          "ready": {
            "capture": "ok",
            "playback": "unknown",
            "codec": "libopus 1.5.2",
            "note": "Basecamp 0.3.2 can't use the microphone on macOS yet: it lacks the microphone permission."
          },
          "recording": {
            "state": "draft",
            "elapsedMs": 4200,
            "capMs": 60000,
            "peak": 0,
            "capped": false,
            "silent": true,
            "error": ""
          },
          "playing": null
        },
        "voiceResultJson": {
          "error": "silent",
          "detail": "Basecamp 0.3.2 can't use the microphone on macOS yet: it lacks the microphone permission."
        }
      }
    },
    {
      "expectProp": [
        "voiceNotice",
        "visible",
        true
      ]
    },
    {
      "expectProp": [
        "voiceNotice",
        "text",
        "~Basecamp 0.3.2 can't use the microphone on macOS yet: it lacks the microphone permission."
      ]
    },
    {
      "shot": "silent"
    },
    {
      "click": "voiceDiscardButton"
    },
    {
      "expect": {
        "slot": "discardVoiceDraft"
      }
    },
    {
      "props": {
        "voiceJson": {
          "ready": {
            "capture": "ok",
            "playback": "unknown",
            "codec": "libopus 1.5.2",
            "note": ""
          },
          "recording": {
            "state": "idle",
            "elapsedMs": 0,
            "capMs": 60000,
            "peak": 0,
            "capped": false,
            "silent": false,
            "error": ""
          },
          "playing": null
        },
        "voiceResultJson": "ok"
      }
    },
    {
      "expectProp": [
        "voiceDraft",
        "visible",
        false
      ]
    },
    {
      "expectProp": [
        "voiceRecordButton",
        "visible",
        true
      ]
    },
    {
      "click": "voiceRecordButton"
    },
    {
      "expect": {
        "slot": "startVoiceRecording"
      }
    },
    {
      "dumpCalls": true
    }
  ]
}
